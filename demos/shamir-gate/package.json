{
  "name": "shamir-gate",
  "version": "1.0.0",
  "description": "Browser-based Shamir's Secret Sharing (SSS) cryptographic demo",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build": "npm run test:publish-request && tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-shamir-gate --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "keywords": [
    "shamir",
    "secret-sharing",
    "cryptography",
    "threshold-cryptography",
    "finite-field",
    "prime-field",
    "lagrange-interpolation",
    "information-theoretic-security"
  ],
  "author": "Crypto Compare Portfolio",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
