{
  "name": "shamir-gate",
  "version": "1.0.0",
  "description": "Browser-based Shamir's Secret Sharing (SSS) cryptographic demo",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "keywords": [
    "shamir",
    "secret-sharing",
    "cryptography",
    "threshold-cryptography",
    "finite-field",
    "prime-field",
    "lagrange-interpolation",
    "information-theoretic-security"
  ],
  "author": "Crypto Compare Portfolio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
